<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material-style host UI using only platform resources so the APK stays offline-buildable. -->
    <style name="Theme.SurfaceControls" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6750A4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAF7FC</item>
        <item name="android:navigationBarColor">#FAF7FC</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
