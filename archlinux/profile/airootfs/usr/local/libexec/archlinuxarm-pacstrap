#!/usr/bin/env bash
set -Eeuo pipefail

real_pacstrap=/usr/lib/surface-laptop-13/pacstrap.real
surface_firmware_root=/usr/lib/firmware
archlinuxarm_build_key=68B3537F39A313B3E574D06777193F152BDBE6A6
target_root=
skip_next=
after_options=

# Find pacstrap's root argument while preserving every original argument for
# the real script. archinstall currently uses: -C /etc/pacman.conf -K /mnt.
for argument in "$@"; do
    if [[ -n "$skip_next" ]]; then
        skip_next=
        continue
    fi
    if [[ -n "$after_options" ]]; then
        target_root=$argument
        break
    fi
    case "$argument" in
        -C|--config)
            skip_next=1
            ;;
        -C/*|--config=*)
            ;;
        --)
            after_options=1
            ;;
        -*)
            ;;
        *)
            target_root=$argument
            break
            ;;
    esac
done

if [[ -n "$target_root" && -d "$target_root" ]]; then
    target_gpgdir="$target_root/etc/pacman.d/gnupg"
    install -d -m 700 "$target_gpgdir"
    if ! grep -Fqx allow-weak-key-signatures "$target_gpgdir/gpg.conf" 2>/dev/null; then
        printf '%s\n' allow-weak-key-signatures >> "$target_gpgdir/gpg.conf"
    fi
    /usr/bin/pacman-key --gpgdir "$target_gpgdir" --init
    /usr/bin/pacman-key --gpgdir "$target_gpgdir" --populate archlinuxarm
    /usr/bin/pacman-key --gpgdir "$target_gpgdir" --lsign-key "$archlinuxarm_build_key"
fi

pacstrap_args=()
surface_kernel_requested=0
dms_greeter_requested=0
zram_requested=0
for argument in "$@"; do
	if [[ "$argument" == linux-surface-laptop-13 ]]; then
		surface_kernel_requested=1
	elif [[ "$argument" == greetd ]]; then
		dms_greeter_requested=1
		pacstrap_args+=("$argument")
	elif [[ "$argument" == zram-generator ]]; then
		zram_requested=1
		pacstrap_args+=("$argument")
	else
		pacstrap_args+=("$argument")
	fi
done

surface_kernel_package=
if (( surface_kernel_requested )); then
    surface_kernel_package=$(find /usr/lib/surface-laptop-13 -maxdepth 1 -type f \
        -name 'linux-surface-laptop-13-*.pkg.tar.*' ! -name '*.sig' -print -quit)
    [[ -n "$surface_kernel_package" && -f "$surface_kernel_package" ]] || {
        printf 'archlinuxarm-pacstrap: bundled Surface kernel package is missing\n' >&2
        exit 1
    }
    # The local package is installed with pacman -U below. Install its repo
    # dependencies through pacstrap first, since pacman -U checks but does not
    # resolve dependencies from the sync databases. systemd-ukify is required
	# by mkinitcpio to embed the Surface DTB in the installed UKI.
	pacstrap_args+=(systemd-ukify wireless-regdb)
fi

dms_greeter_package=
if (( dms_greeter_requested )); then
	dms_greeter_package=$(find /usr/lib/surface-laptop-13 -maxdepth 1 -type f \
		-name 'greetd-dms-greeter-bin-*.pkg.tar.*' ! -name '*.sig' -print -quit)
	[[ -n "$dms_greeter_package" && -f "$dms_greeter_package" ]] || {
		printf 'archlinuxarm-pacstrap: bundled DMS greeter package is missing\n' >&2
		exit 1
	}
	# pacman -U checks dependencies but does not resolve them from sync
	# databases. Install the runtime dependencies in the same pacstrap call.
	pacstrap_args+=(quickshell qt6-declarative)
fi

stage_surface_firmware() {
    local relative source destination
    [[ -n "$target_root" ]] || return 0
    for relative in \
        qcom/gen71500_sqe.fw \
        qcom/gen71500_gmu.bin \
        qcom/gen71500_zap.mbn \
        qcom/x1p42100/Microsoft/Surface12/qcdxkmsucpurwa.mbn \
        ath12k/WCN7850/hw2.0/amss.bin \
        ath12k/WCN7850/hw2.0/m3.bin \
        ath12k/WCN7850/hw2.0/board.bin \
        ath12k/WCN7850/hw2.0/board-2.bin \
        qca/hmtbtfw20.tlv \
        qca/hmtnv20.b10f \
        qca/hmtnv20.b112 \
        qca/hmtnv20.bin \
        regulatory.db regulatory.db.p7s; do
        source="$surface_firmware_root/$relative"
        [[ -s "$source" ]] || {
            printf 'archlinuxarm-pacstrap: live firmware is missing: %s\n' "$relative" >&2
            return 1
        }
        destination="$target_root/usr/lib/firmware/$relative"
        install -D -m 0644 "$source" "$destination"
    done
}

install_surface_kernel_package() {
    (( surface_kernel_requested )) || return 0
    /usr/bin/pacman \
        --root "$target_root" \
        --dbpath "$target_root/var/lib/pacman" \
        --cachedir "$target_root/var/cache/pacman/pkg" \
        --config /etc/pacman.conf \
        --noconfirm \
		-U "$surface_kernel_package"
}

install_dms_greeter_package() {
	(( dms_greeter_requested )) || return 0
	/usr/bin/pacman \
		--root "$target_root" \
		--dbpath "$target_root/var/lib/pacman" \
		--cachedir "$target_root/var/cache/pacman/pkg" \
		--config /etc/pacman.conf \
		--noconfirm \
		-U "$dms_greeter_package"
}

install_zram_configuration() {
	(( zram_requested )) || return 0
	[[ -n "$target_root" ]] || return 0
	[[ -f /etc/systemd/zram-generator.conf ]] || {
		printf 'archlinuxarm-pacstrap: live zram-generator.conf is missing\n' >&2
		return 1
	}
	install -D -m 0644 /etc/systemd/zram-generator.conf \
		"$target_root/etc/systemd/zram-generator.conf"
}

ensure_archinstall_kernel_preset() {
    local preset_dir source_preset

    [[ -n "$target_root" ]] || return 0
    preset_dir="$target_root/etc/mkinitcpio.d"
    [[ -d "$preset_dir" && ! -e "$preset_dir/linux.preset" ]] || return 0

    # The Surface preset is named after the custom package and already
    # contains the UKI settings archinstall needs.
    [[ -e "$preset_dir/linux-surface-laptop-13.preset" ]] && return 0

    # Arch Linux ARM names the preset after the package name
    # (linux-aarch64.preset), while archinstall's default kernel entry is
    # still named linux and therefore looks for linux.preset when configuring
    # UKIs. Keep the ARM preset contents, including ALL_kver, unchanged.
    source_preset="$preset_dir/linux-aarch64.preset"
    if [[ ! -f "$source_preset" ]]; then
        source_preset=$(find "$preset_dir" -maxdepth 1 -type f \
            -name 'linux-*.preset' -print | sort | head -n1)
    fi
    if [[ -z "$source_preset" || ! -f "$source_preset" ]]; then
        printf 'archlinuxarm-pacstrap: no Arch Linux ARM kernel preset found in %s\n' \
            "$preset_dir" >&2
        return 1
    fi

    cp -p -- "$source_preset" "$preset_dir/linux.preset"
    if ! grep -Eq '^#?default_uki=' "$preset_dir/linux.preset"; then
        printf '%s\n' \
            '' \
            '# Added for archinstall UKI boot mode. archinstall adjusts this' \
            '# path to the actual ESP mountpoint before invoking mkinitcpio.' \
            '#default_uki="/efi/EFI/Linux/arch-linux.efi"' \
            '#default_options=""' >> "$preset_dir/linux.preset"
    fi
    printf 'archlinuxarm-pacstrap: created %s from %s for archinstall\n' \
        "$preset_dir/linux.preset" "${source_preset##*/}" >&2
}

pacstrap_status=0
if "$real_pacstrap" "${pacstrap_args[@]}"; then
    pacstrap_status=0
else
    pacstrap_status=$?
fi

if (( pacstrap_status == 0 )); then
	install_surface_kernel_package || pacstrap_status=$?
fi

if (( pacstrap_status == 0 )); then
	install_dms_greeter_package || pacstrap_status=$?
fi

if (( pacstrap_status == 0 )); then
	install_zram_configuration || pacstrap_status=$?
fi

if (( pacstrap_status == 0 )); then
	stage_surface_firmware || pacstrap_status=$?
fi

if (( pacstrap_status == 0 )); then
    ensure_archinstall_kernel_preset || pacstrap_status=$?
fi

exit "$pacstrap_status"
