From: amania-Jailbreak <amania@users.noreply.github.com>
Subject: [PATCH] drm: keep Surface eDP hardware active while blanked

The Surface Laptop for Business 13in 1st Ed with Snapdragon resets while
the internal eDP output is disabled. Windows uses a coordinated Surface
panel/display power path and does not treat monitor-off as an unconditional
eDP PHY teardown.

Add two opt-in Device Tree properties. The MSM DP property keeps the link,
PHY and runtime-PM references alive while the connector is blanked, using
PSR when the panel advertises it. The panel-bridge property keeps the eDP
panel prepared while still allowing drm_panel_disable() to turn off the
backlight. Re-enable performs the matching PSR exit or stream restart
without acquiring duplicate runtime-PM references.

The normal DP and panel paths are unchanged unless both properties are
present in the board Device Tree.
---
 drivers/gpu/drm/bridge/panel.c      | 14 ++++++++++++++
 drivers/gpu/drm/msm/dp/dp_display.c | 27 +++++++++++++++++++++++++++
 2 files changed, 41 insertions(+)

--- a/drivers/gpu/drm/bridge/panel.c
+++ b/drivers/gpu/drm/bridge/panel.c
@@ -6,6 +6,7 @@
 
 #include <linux/debugfs.h>
 #include <linux/export.h>
+#include <linux/property.h>
 
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_bridge.h>
@@ -23,6 +24,8 @@
 	struct drm_connector connector;
 	struct drm_panel *panel;
 	u32 connector_type;
+	bool keep_prepared_on_disable;
+	bool prepared_was_kept;
 };
 
 static inline struct panel_bridge *
@@ -125,6 +128,10 @@
 	old_crtc_state = drm_atomic_get_old_crtc_state(atomic_state, crtc);
 	if (old_crtc_state && old_crtc_state->self_refresh_active)
 		return;
+	if (panel_bridge->prepared_was_kept) {
+		panel_bridge->prepared_was_kept = false;
+		return;
+	}
 
 	drm_panel_prepare(panel_bridge->panel);
 }
@@ -182,6 +189,10 @@
 	new_crtc_state = drm_atomic_get_new_crtc_state(atomic_state, crtc);
 	if (new_crtc_state && new_crtc_state->self_refresh_active)
 		return;
+	if (panel_bridge->keep_prepared_on_disable) {
+		panel_bridge->prepared_was_kept = true;
+		return;
+	}
 
 	drm_panel_unprepare(panel_bridge->panel);
 }
@@ -295,6 +306,9 @@
 
 	panel_bridge->connector_type = connector_type;
 	panel_bridge->panel = panel;
+	panel_bridge->keep_prepared_on_disable =
+		device_property_read_bool(panel->dev,
+					  "keep-panel-prepared-on-disable");
 
 	panel_bridge->bridge.of_node = panel->dev->of_node;
 	panel_bridge->bridge.ops = DRM_BRIDGE_OP_MODES;
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -55,6 +55,8 @@
 
 	struct mutex plugged_lock;
 	bool plugged;
+	bool keep_edp_active_on_blank;
+	bool edp_blanked;
 
 	struct drm_device *drm_dev;
 
@@ -1143,6 +1145,9 @@
 	desc = msm_dp_display_get_desc(pdev);
 	if (!desc)
 		return -EINVAL;
+	dp->keep_edp_active_on_blank =
+		of_property_read_bool(pdev->dev.of_node,
+				      "qcom,keep-edp-active-on-blank");
 
 	dp->msm_dp_display.pdev = pdev;
 	dp->id = desc->id;
@@ -1362,6 +1367,17 @@
 	bool force_link_train = false;
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+	if (dp->is_edp && msm_dp_display->edp_blanked) {
+		if (dp->psr_supported)
+			msm_dp_display_set_psr(dp, false);
+		else
+			msm_dp_ctrl_on_stream(msm_dp_display->ctrl, false);
+
+		msm_dp_display->edp_blanked = false;
+		drm_dbg_dp(dp->drm_dev,
+			   "restored eDP without a full power cycle\n");
+		return;
+	}
 	if (!msm_dp_display->msm_dp_mode.drm_mode.clock) {
 		DRM_ERROR("invalid params\n");
 		return;
@@ -1415,6 +1431,17 @@
 	struct msm_dp_display_private *msm_dp_display;
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+	if (dp->is_edp && msm_dp_display->keep_edp_active_on_blank) {
+		if (dp->psr_supported)
+			msm_dp_display_set_psr(dp, true);
+		else
+			msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
+
+		msm_dp_display->edp_blanked = true;
+		drm_dbg_dp(dp->drm_dev,
+			   "kept eDP active while connector is blanked\n");
+		return;
+	}
 
 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
 }
@@ -1427,6 +1454,8 @@
 	struct msm_dp_display_private *msm_dp_display;
 
 	msm_dp_display = container_of(dp, struct msm_dp_display_private, msm_dp_display);
+	if (dp->is_edp && msm_dp_display->edp_blanked)
+		return;
 
 	if (dp->is_edp)
 		msm_dp_hpd_unplug_handle(msm_dp_display);
-- 
2.47.2
