# Optional hardware and desktop support for the Surface kernel.
#
# This is a Kconfig fragment, not a complete defconfig.  build.sh merges it
# with base.config and runs olddefconfig, so symbols unavailable in an older
# kernel are left at their kernel defaults.

# Loadable modules are needed for the optional network and filesystem clients.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Network interfaces and firewall features used by desktop systems,
# containers, VPNs, and network namespaces.
CONFIG_TLS=m
CONFIG_NET_UDP_TUNNEL=m
CONFIG_WIREGUARD=m
CONFIG_IPVLAN=m
CONFIG_BONDING=m
CONFIG_DUMMY=m
CONFIG_IFB=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=m
CONFIG_IP_NF_NAT=m
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_SCH_NETEM=m

# SMB/CIFS client support.  SMB1 and CIFS debug output stay disabled.
CONFIG_CIFS=m
CONFIG_CIFS_STATS2=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=n
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=n
CONFIG_CIFS_DEBUG=n
CONFIG_CIFS_DEBUG2=n
CONFIG_CIFS_DEBUG_DUMP_KEYS=n
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_CIFS_SWN_UPCALL=y
CONFIG_CIFS_COMPRESSION=y

# Filesystems commonly used for removable media, images, and other hosts.
CONFIG_EXT2_FS=m
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_FUSE_FS=m
CONFIG_CUSE=m
CONFIG_OVERLAY_FS=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_MSDOS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_HFS_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_EROFS_FS=m
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_NLS_UTF8=m
CONFIG_SQUASHFS_ZSTD=y

# Common encrypted/assembled storage targets.
CONFIG_DM_CRYPT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_INTEGRITY=m
CONFIG_DM_SNAPSHOT=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m

# Generic input, camera, and virtualisation support expected by desktop
# distributions.  Surface-specific drivers remain in base.config.
CONFIG_HIDRAW=y
CONFIG_INPUT_UINPUT=m
CONFIG_VHOST_NET=m
CONFIG_KVM=y

# Do not enable verbose WireGuard or DRM diagnostic output in normal builds.
CONFIG_WIREGUARD_DEBUG=n
CONFIG_DRM_PANIC_DEBUG=n
CONFIG_DRM_DEBUG_DP_MST_TOPOLOGY_REFS=n
