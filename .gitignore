# Build outputs and local recovery sets are never committed.
SURFACE-CURRENT/
out/
artifacts/
*.efi
*.dtb
*.img
*.dtbo
*.apk
*.log
device-tree/base/*.dtb
drivers/firmware/
kernel/source/

# Generated language/tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.gradle/
.github/*/build/

# Local source checkouts and OS-specific inputs.
kernel/source/
initramfs/base/
.env
.env.*
