#!/bin/sh

# Installed-system GRUB entries for the Surface Laptop for Business 13.
#
# The EL2 entry must chainload the Secure Launch bridge.  A direct linux entry
# with id_aa64mmfr0.ecv=1 is not an EL2 boot: it bypasses slbounce and merely
# asks an EL1 kernel to expose KVM.  Keep that misleading path out of the
# installed menu.
cat <<'GRUB_ENTRY'
menuentry 'Proxmox VE - Surface Laptop 13 (FUSE/PVE ready)' --id surface-el1-ready --class debian --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod ext2
    search --no-floppy --fs-uuid --set=root f621d247-7647-4244-aad3-1fffe95afe92
    linux /boot/vmlinuz-7.2.0-rc5-surface-laptop-13 root=UUID=f621d247-7647-4244-aad3-1fffe95afe92 rootfstype=ext4 rootwait rw
    devicetree /boot/surface-laptop-13.dtb
    initrd /boot/initrd.img-7.2.0-rc5-surface-laptop-13
}
menuentry 'Proxmox VE - Surface Laptop 13 (pre-FUSE recovery)' --id surface-el1-recovery --class debian --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod ext2
    search --no-floppy --fs-uuid --set=root f621d247-7647-4244-aad3-1fffe95afe92
    linux /boot/vmlinuz-7.2.0-rc5-surface-laptop-13.pre-fuse-20260901 root=UUID=f621d247-7647-4244-aad3-1fffe95afe92 rootfstype=ext4 rootwait rw
    devicetree /boot/surface-laptop-13.dtb.pre-fuse-20260901
    initrd /boot/initrd.img-7.2.0-rc5-surface-laptop-13.pre-fuse-20260901
}
menuentry 'Proxmox VE - Surface Laptop 13 (EL2/KVM; fallback to ready)' --id surface-el2-kvm --class debian --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod fat
    insmod ext2
    insmod chain
    insmod search_fs_uuid
    insmod loadenv
    insmod sleep
    insmod reboot
    if search --no-floppy --fs-uuid --set=esp 584B-B4D4; then
        if search --no-floppy --fs-uuid --set=surface_root f621d247-7647-4244-aad3-1fffe95afe92; then
            set next_entry=surface-el1-ready
            if save_env -f ($surface_root)/boot/grub/grubenv next_entry; then
                if chainloader ($esp)/EFI/BOOT/surface-kvm-entry.efi; then
                    boot
                    # The child may have installed the Secure Launch hook.
                    echo 'surface-kvm: launcher returned; rebooting to Ready'
                    sleep 5
                    reboot
                else
                    echo 'surface-kvm: EFI launcher could not be loaded'
                fi
            else
                echo 'surface-kvm: cannot save Ready fallback; launch cancelled'
            fi
        else
            echo 'surface-kvm: Ready root filesystem not found'
        fi
    else
        echo 'surface-kvm: ESP UUID 584B-B4D4 not found'
    fi
}
submenu 'Advanced Options (Surface EL2/KVM)' {
menuentry 'Proxmox VE - Surface Laptop 13 (EL2/KVM; without UFS)' --id surface-el2-kvm-without-ufs --class debian --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod fat
    insmod ext2
    insmod chain
    insmod search_fs_uuid
    insmod loadenv
    insmod sleep
    insmod reboot
    if search --no-floppy --fs-uuid --set=esp 584B-B4D4; then
        if search --no-floppy --fs-uuid --set=surface_root f621d247-7647-4244-aad3-1fffe95afe92; then
            set next_entry=surface-el1-ready
            if save_env -f ($surface_root)/boot/grub/grubenv next_entry; then
                if chainloader ($esp)/EFI/BOOT/surface-kvm-entry-without-ufs.efi; then
                    boot
                    echo 'surface-kvm: without-UFS launcher returned; rebooting to Ready'
                    sleep 5
                    reboot
                else
                    echo 'surface-kvm: without-UFS EFI launcher could not be loaded'
                fi
            else
                echo 'surface-kvm: cannot save Ready fallback; launch cancelled'
            fi
        else
            echo 'surface-kvm: Ready root filesystem not found'
        fi
    else
        echo 'surface-kvm: ESP UUID 584B-B4D4 not found'
    fi
}
}
GRUB_ENTRY
